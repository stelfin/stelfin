# stelfin — copy to .env and fill in. Every value below is required unless
# marked optional; the server refuses to start rather than run with a
# placeholder secret.

# Where the confirmation page is served from. Must be https (or http://localhost
# for development) — confirmation links carry payment authority.
STELFIN_BASE_URL=https://stelfin.example
STELFIN_HTTP_ADDR=:8080

STELFIN_DATABASE_URL=postgres://stelfin:stelfin@localhost:5432/stelfin?sslmode=disable

# testnet | public. Defaults to testnet.
STELFIN_NETWORK=testnet
STELFIN_HORIZON_URL=https://horizon-testnet.stellar.org

# The Soroban RPC endpoint. Optional: without it stelfin serves everything else
# and refuses contract calls with a message saying why.
#
# Deliberately no default. An RPC decides what a contract call is simulated
# against, and a default would point a mainnet deployment at whatever endpoint
# happened to be written in this file.
STELFIN_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Where token-event ingestion starts when it has no cursor yet.
#
# An RPC keeps a bounded window of events, so "from the beginning" is not
# something it can serve. Left unset, token-event ingestion does not begin on a
# fresh deployment: it logs that it has nowhere to start and keeps saying so
# until this names a ledger. Starting at whatever the endpoint happens to still
# hold on the day you deploy would silently skip everything before it, so
# choosing a ledger is how you say which history you accept having missed. A
# current one: curl -s https://horizon-testnet.stellar.org/ | jq .history_latest_ledger
# It is only read the first time; after that ingestion resumes from its cursor.
STELFIN_SOROBAN_START_LEDGER=

# The treasury pays every fee and sponsors every account reserve.
#
# Reading this from the environment is acceptable on testnet and NOT acceptable
# for real money: the seed is materialised in the process and lands in anything
# that dumps the environment. On mainnet, move signing into an HSM or KMS — the
# server takes a signing function, so that is a wiring change, not a redesign.
STELFIN_TREASURY_SEED=S...

# Signs SEP-10 challenges, which is how a member proves they control a wallet.
#
# Optional: without it the bot runs and says linking is unavailable. It must be
# a DIFFERENT key from the treasury, and that is checked at startup. It signs
# attacker-chosen material and controls nothing, which is the only reason it can
# live in the process at all — it is the one key here that cannot go behind a
# remote signer, because the SDK's challenge builder takes a seed rather than a
# signing function. Fund it with nothing.
STELFIN_WEBAUTH_SEED=

# The asset users transact in. The issuer is network-specific: this is Circle's
# USDC issuer on the network you configured above, and getting it wrong points
# the whole system at a different token.
STELFIN_ASSET_CODE=USDC
STELFIN_ASSET_ISSUER=G...

# Telegram. Optional, and required together — a bot with no webhook secret
# cannot authenticate a delivery at all. Leave both empty and the server runs
# with no Telegram transport: the signing pages are still served, and
# /webhook/telegram answers 404.
#
# Telegram does NOT sign its webhook deliveries; it echoes this secret back in
# a header. That makes the secret the only thing authenticating a delivery, so
# it is held to the same bar as the confirm secret below: at least 32
# characters of real randomness. stelfin gives it to Telegram itself at start.
STELFIN_TELEGRAM_BOT_TOKEN=
STELFIN_TELEGRAM_WEBHOOK_SECRET=
# Optional. The Bot API root, for a self-hosted Bot API server. Empty uses
# Telegram's own. Must be https unless it is this machine: the bot token is
# part of every request sent to it.
STELFIN_TELEGRAM_API_URL=

# Discord. Optional, and all three together.
#
# Unlike the Telegram secret, the public key is not a bearer: it verifies an
# Ed25519 signature over each delivery, so a leaked copy forges nothing. Copy
# it, the bot token and the application id from the developer portal, and point
# the Interactions Endpoint URL at <base>/webhook/discord.
STELFIN_DISCORD_PUBLIC_KEY=
STELFIN_DISCORD_BOT_TOKEN=
STELFIN_DISCORD_APPLICATION_ID=
# Optional. Discord's REST root, for a proxy you run. https, or this machine:
# the bot token is sent to it.
STELFIN_DISCORD_API_URL=

# Signs the confirmation links that authorise payments. At least 32 bytes of
# real randomness — generate with: openssl rand -hex 32
STELFIN_CONFIRM_TOKEN_SECRET=

# Optional. Empty lets the Anthropic SDK resolve credentials itself.
ANTHROPIC_API_KEY=
# Optional: low | medium | high | xhigh | max.
STELFIN_DECODER_EFFORT=

# Optional.
STELFIN_SHUTDOWN_GRACE=20s

# The deployment-wide kill switch. true: everything that reads keeps working,
# nothing new is built and nothing is submitted. Here, in the environment, and
# not in the database, because the moment it is needed may be a moment the
# database is the thing that is not trusted. To stop one workspace instead:
#   stelfinctl suspend <org id>
STELFIN_READONLY=
# The same, without a restart: while a file exists at this path, nothing is
# built or submitted. touch it to stop, remove it to resume. Looked for on
# every write; if it cannot be looked for, the answer is read-only.
STELFIN_READONLY_FILE=

# This deployment's own ceilings on treasury proposals, in whole units of the
# asset, across every workspace: the largest single proposal, and the most
# proposed in any 24 hours. Empty means none. Workspaces set their own, lower,
# with /limits. Required on the public network.
STELFIN_MAX_PAYMENT=
STELFIN_MAX_DAILY=

# Connectors: the tools a workspace already uses — a spreadsheet, somebody's
# MCP server, an HTTP endpoint that returns rows. Both optional, and each
# enables its own half. With neither, connector commands say they are not
# available here.
#
# Seals what a workspace's connectors need kept at rest: where each one is and
# the token it is reached with. 32 bytes, hex — openssl rand -hex 32. Losing or
# changing it loses every sealed endpoint and token; they are re-entered on the
# set-up page, which also ends their grants.
STELFIN_CONNECTOR_KEY=
# A Google service-account key, as the JSON Google issues — inline, or a path
# to the file. One account for the deployment; a workspace shares its sheet
# with the account's address, as a viewer, and that is all it can ever read.
STELFIN_GOOGLE_SERVICE_ACCOUNT=
STELFIN_GOOGLE_SERVICE_ACCOUNT_FILE=

# Calling allowed third-party contracts from a treasury (/contract, /invoke).
# Off unless true. A contract call moves money in ways the spend ceilings above
# cannot see — a ceiling bounds a payment, and a call is whatever the contract
# does — so a deployment that relies on its ceilings must opt in to this.
# Needs STELFIN_SOROBAN_RPC_URL.
STELFIN_CONTRACT_CALLS=

# Required on the public network, and only there. The operator key above is
# read from the environment, so a deployment does not start against real money
# unless this says, exactly:   this deployment moves real funds
STELFIN_MAINNET_ACK=
