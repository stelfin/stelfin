# stelfin — copy to .env and fill in. Every value below is required unless
# marked optional; the server refuses to start rather than run with a
# placeholder secret.

# Where the confirmation page is served from. Must be https (or http://localhost
# for development) — confirmation links carry payment authority.
STELFIN_BASE_URL=https://stelfin.example
STELFIN_HTTP_ADDR=:8080

STELFIN_DATABASE_URL=postgres://stelfin:stelfin@localhost:5432/stelfin?sslmode=disable

# testnet | public. Defaults to testnet.
STELFIN_NETWORK=testnet
STELFIN_HORIZON_URL=https://horizon-testnet.stellar.org

# The treasury pays every fee and sponsors every account reserve.
#
# Reading this from the environment is acceptable on testnet and NOT acceptable
# for real money: the seed is materialised in the process and lands in anything
# that dumps the environment. On mainnet, move signing into an HSM or KMS — the
# server takes a signing function, so that is a wiring change, not a redesign.
STELFIN_TREASURY_SEED=S...

# The asset users transact in. The issuer is network-specific: this is Circle's
# USDC issuer on the network you configured above, and getting it wrong points
# the whole system at a different token.
STELFIN_ASSET_CODE=USDC
STELFIN_ASSET_ISSUER=G...

# Telegram. Optional, and required together — a bot with no webhook secret
# cannot authenticate a delivery at all. Leave both empty and the server runs
# with no Telegram transport: the signing pages are still served, and
# /webhook/telegram answers 404.
#
# Telegram does NOT sign its webhook deliveries; it echoes this secret back in
# a header. That makes the secret the only thing authenticating a delivery, so
# it is held to the same bar as the confirm secret below: at least 32
# characters of real randomness. Pass the same value to setWebhook.
STELFIN_TELEGRAM_BOT_TOKEN=
STELFIN_TELEGRAM_WEBHOOK_SECRET=

# Discord credentials go here once that transport exists.

# Signs the confirmation links that authorise payments. At least 32 bytes of
# real randomness — generate with: openssl rand -hex 32
STELFIN_CONFIRM_TOKEN_SECRET=

# Optional. Empty lets the Anthropic SDK resolve credentials itself.
ANTHROPIC_API_KEY=
# Optional: low | medium | high | xhigh | max.
STELFIN_DECODER_EFFORT=

# Optional.
STELFIN_SHUTDOWN_GRACE=20s
